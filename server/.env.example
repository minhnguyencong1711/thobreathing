# Cấu hình MongoDB Atlas (hoặc MongoDB local)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/thobreathing?retryWrites=true&w=majority

# Cổng khởi chạy Server
PORT=3000

# CORS Whitelist (khi chạy riêng lẻ nếu cần)
